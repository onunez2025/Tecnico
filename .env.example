# ============================================================
# VARIABLES DE ENTORNO - Tecnico / Gestión Técnica de Servicios
# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el archivo .env al repositorio.
# ============================================================

# --- SERVIDOR ---
PORT=3000
NODE_ENV=development
# En production usar el dominio real, ej: https://app.mti.com.pe
ALLOWED_ORIGIN=http://localhost:3000

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# --- BASE DE DATOS AZURE SQL ---
DB_SERVER=tu-servidor.database.windows.net
DB_DATABASE=nombre_base_de_datos
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql

# --- AZURE BLOB STORAGE ---
# Obtener desde: Azure Portal > Storage Account > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=stecnico

# --- RUTAS LOCALES (solo si se usan montajes locales) ---
# Ruta al directorio donde AppSheet almacena los PDFs de cotizaciones.
# Dejar vacío si no se usa esta función.
APPSHEET_PDF_PATH=

# Ruta al directorio de imágenes estáticas (OneDrive mount / R2 mount).
# Dejar vacío si no se usa esta función.
IMAGE_STORAGE_PATH=

# --- REDIS (rate limiting / blacklist de tokens) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Índice de base lógica de Redis — aísla contadores entre prod y QA
REDIS_DB=0

# --- SMTP (envío de correo, respaldo si no hay Microsoft Graph) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=

# --- Microsoft Graph (envío de correo) ---
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=

# --- Casdoor SSO (login social Google/Microsoft) ---
CASDOOR_ENDPOINT=https://auth.siatc.cloud
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=https://technical.siatc.cloud/api/auth/sso/callback
FRONTEND_URL=https://technical.siatc.cloud
